.mdblist-ratings-row{align-items:center;display:flex;flex-wrap:wrap;gap:20px;margin-bottom:24px;opacity:0;transform:translateY(10px);transition:opacity .6s ease,transform .6s ease}.mdblist-ratings-row.visible{opacity:1;transform:translateY(0)}.mdblist-ratings-row>div{margin-right:20px}.mdblist-ratings-row>div:last-child{margin-right:0}.mdblist-item{color:var(--jf-text-primary,#fff);font-size:1.2rem;font-weight:500}.mdblist-item,.provider-icon{align-items:center;display:flex}.provider-icon{height:32px;justify-content:center;margin-right:8px;min-width:28px}.provider-icon img{display:block;height:100%;object-fit:contain;width:auto}.provider-icon .star-emoji{align-items:center;color:#f6c700;display:flex;font-size:28px;justify-content:center;line-height:1}.icon-imdb img{height:24px}.icon-tmdb img{height:22px}.icon-letterboxd img{height:24px}.icon-trakt img{height:26px}.icon-rt img,.icon-rt-aud img{height:28px}.icon-metacritic img,.icon-metacritic-user img{height:26px}.icon-metacritic-ms img{height:32px;margin-top:-2px}.icon-rogerebert img{height:30px}.icon-anilist img,.icon-kinopoisk img,.icon-mal img{height:26px}.icon-tvmaze img{height:20px}.icon-imdb-top250 img{height:26px}.icon-allocine img,.icon-allocine-users img,.icon-betaseries img,.icon-mdblist img,.icon-senscritique img,.icon-simkl img,.icon-whatson img{height:24px}.mdblist-value{font-variant-numeric:tabular-nums;letter-spacing:.3px;line-height:32px}.mdblist-awards-row{align-items:center;display:flex;flex-wrap:wrap;gap:12px;margin-bottom:24px;margin-top:16px;max-width:95%;opacity:0;transform:translateY(10px);transition:opacity .8s ease,transform .8s ease;transition-delay:.2s}.mdblist-awards-row.visible{opacity:1;transform:translateY(0)}.award-item{flex-shrink:0}.award-icon,.award-item{align-items:center;display:flex;height:40px}.award-icon{justify-content:center}.award-icon img{background:rgba(0,0,0,.2);border:1px solid hsla(0,0%,100%,.1);border-radius:6px;box-shadow:0 4px 8px rgba(0,0,0,.4);box-sizing:border-box;display:block;height:40px!important;max-height:40px;object-fit:contain;opacity:.95;width:auto!important}.mdblist-awards-row:focus,.mdblist-ratings-row:focus{outline:none}